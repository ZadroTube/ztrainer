{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			],
			"env": {
				"DEFAULT_MINIMUM_TOKENS": ""
			},
			"disabled": false,
			"alwaysAllow": []
		},
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"./src"
			],
			"env": {}
		},
		"grep-app": {
			"type": "streamable-http",
			"url": "https://mcp.grep.app"
		},
		"repomix": {
			"command": "npx",
			"args": [
				"-y",
				"repomix",
				"--mcp"
			],
			"disabled": false,
			"autoApprove": []
		}
	}
}